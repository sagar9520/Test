<?xml version="1.0" encoding="utf-8"?>
<!--
    Loading skeleton with exactly the same geometry as ad_native_large.xml (same paddings, the
    same fixed media/CTA heights and real text lines in the same styles, so it also matches at
    any font scale). The Continue button below the native ad therefore never jumps.
-->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/native_placeholder"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="@drawable/bg_ad_card"
    android:importantForAccessibility="noHideDescendants"
    android:orientation="vertical"
    android:paddingStart="12dp"
    android:paddingTop="8dp"
    android:paddingEnd="12dp"
    android:paddingBottom="8dp">

    <TextView
        style="@style/Xray.Ad.Badge"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content" />

    <LinearLayout
        android:id="@+id/native_placeholder_shimmer"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:gravity="center_vertical"
            android:minHeight="@dimen/native_header_height"
            android:orientation="horizontal">

            <View
                style="@style/Xray.Ad.Skeleton"
                android:layout_width="@dimen/native_icon_size"
                android:layout_height="@dimen/native_icon_size" />

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="12dp"
                android:layout_weight="1"
                android:orientation="vertical">

                <TextView
                    style="@style/Xray.Ad.Headline"
                    android:layout_width="170dp"
                    android:layout_height="wrap_content"
                    android:background="@drawable/bg_skeleton_text"
                    android:importantForAccessibility="no"
                    android:text="@string/skeleton_line" />

                <TextView
                    style="@style/Xray.Ad.Meta"
                    android:layout_width="96dp"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="1dp"
                    android:background="@drawable/bg_skeleton_text"
                    android:fontFamily="@font/poppins_medium"
                    android:importantForAccessibility="no"
                    android:text="@string/skeleton_line" />

                <TextView
                    style="@style/Xray.Ad.Meta"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:background="@drawable/bg_skeleton_text"
                    android:importantForAccessibility="no"
                    android:text="@string/skeleton_line" />
            </LinearLayout>
        </LinearLayout>

        <FrameLayout
            android:layout_width="match_parent"
            android:layout_height="@dimen/native_media_height"
            android:layout_marginTop="7dp"
            android:background="@drawable/bg_skeleton">

            <TextView
                style="@style/Xray.Ad.Meta"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="center"
                android:text="@string/ad_loading"
                android:textColor="@color/text_tertiary" />
        </FrameLayout>

        <View
            android:layout_width="match_parent"
            android:layout_height="@dimen/native_cta_height"
            android:layout_marginTop="7dp"
            android:background="@drawable/bg_skeleton_pill" />
    </LinearLayout>

</LinearLayout>
