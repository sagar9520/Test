<?xml version="1.0" encoding="utf-8"?>
<!-- Ready screen: summary of the answers, optional rewarded "HD scan" unlock, Start scan
     (interstitial at this natural break), Start over. ONE native below, NO banner. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/xr_bg"
    android:orientation="vertical"
    tools:context=".ui.ScanReadyActivity">

    <include
        layout="@layout/view_step_header"
        android:layout_width="match_parent"
        android:layout_height="wrap_content" />

    <androidx.core.widget.NestedScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:clipToPadding="false"
        android:fillViewport="true">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingStart="@dimen/xr_screen_padding"
            android:paddingTop="16dp"
            android:paddingEnd="@dimen/xr_screen_padding"
            android:paddingBottom="@dimen/xr_gap_section">

            <TextView
                android:id="@+id/ready_title"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/ready_title"
                android:textAppearance="@style/TextAppearance.XRay.Headline" />

            <TextView
                android:id="@+id/ready_subtitle"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:text="@string/ready_subtitle"
                android:textAppearance="@style/TextAppearance.XRay.Body" />

            <!-- Summary of the chosen options -->
            <com.google.android.material.card.MaterialCardView
                android:id="@+id/summary_card"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/xr_gap_section">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="16dp">

                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="@string/ready_setup_label"
                        android:textAppearance="@style/TextAppearance.XRay.Overline" />

                    <com.google.android.material.chip.ChipGroup
                        android:id="@+id/summary_chips"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="8dp"
                        app:chipSpacingHorizontal="8dp"
                        app:chipSpacingVertical="0dp" />
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <!-- Rewarded unlock: HD scan -->
            <com.google.android.material.card.MaterialCardView
                style="@style/Widget.XRay.Card.Premium"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/xr_gap_small">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="16dp">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:gravity="center_vertical"
                        android:orientation="horizontal">

                        <FrameLayout
                            android:layout_width="44dp"
                            android:layout_height="44dp"
                            android:background="@drawable/bg_icon_circle_secondary">

                            <ImageView
                                android:layout_width="24dp"
                                android:layout_height="24dp"
                                android:layout_gravity="center"
                                android:importantForAccessibility="no"
                                android:src="@drawable/ic_hd"
                                app:tint="@color/xr_secondary" />
                        </FrameLayout>

                        <LinearLayout
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_marginStart="12dp"
                            android:layout_weight="1"
                            android:orientation="vertical">

                            <TextView
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:text="@string/hd_title"
                                android:textAppearance="@style/TextAppearance.XRay.Title" />

                            <TextView
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:layout_marginTop="2dp"
                                android:text="@string/hd_desc"
                                android:textAppearance="@style/TextAppearance.XRay.Body" />
                        </LinearLayout>
                    </LinearLayout>

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/hd_button"
                        style="@style/Widget.XRay.Button.Tonal"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="12dp"
                        android:text="@string/hd_button"
                        app:icon="@drawable/ic_play_ad" />

                    <TextView
                        android:id="@+id/hd_status"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="12dp"
                        android:drawablePadding="8dp"
                        android:gravity="center_vertical"
                        android:minHeight="@dimen/xr_touch_target"
                        android:text="@string/hd_unlocked"
                        android:textAppearance="@style/TextAppearance.XRay.Label"
                        android:visibility="gone"
                        app:drawableStartCompat="@drawable/ic_check"
                        app:drawableTint="@color/xr_primary"
                        tools:visibility="visible" />
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <com.google.android.material.button.MaterialButton
                android:id="@+id/start_button"
                style="@style/Widget.XRay.Button.Primary"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/xr_gap_section"
                android:text="@string/start_scan"
                app:icon="@drawable/ic_bolt" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/restart_button"
                style="@style/Widget.XRay.Button.Text"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:text="@string/restart"
                app:icon="@drawable/ic_replay" />

            <include
                android:id="@+id/native_slot"
                layout="@layout/view_native_ad_slot"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/xr_gap_ad" />

            <include
                android:id="@+id/fact_card"
                layout="@layout/view_fact_card"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/xr_gap_section" />

            <TextView
                android:id="@+id/disclaimer"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                android:gravity="center"
                android:text="@string/disclaimer"
                android:textAppearance="@style/TextAppearance.XRay.Caption" />
        </LinearLayout>
    </androidx.core.widget.NestedScrollView>
</LinearLayout>
