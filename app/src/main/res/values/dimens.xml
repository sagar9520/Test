<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- Page: ads use the full content width (10dp from the screen edges, like the reference
         video); option cards, title and Continue are inset a little more (16dp from the edges). -->
    <dimen name="ad_padding_h">10dp</dimen>
    <dimen name="option_inset_h">6dp</dimen>

    <!-- Option cards -->
    <dimen name="option_spacing">10dp</dimen>
    <dimen name="option_min_height">70dp</dimen>
    <dimen name="option_radius">16dp</dimen>
    <dimen name="thumb_width">64dp</dimen>
    <dimen name="thumb_height">46dp</dimen>
    <dimen name="radio_size">24dp</dimen>

    <!-- Continue button -->
    <dimen name="continue_height">52dp</dimen>
    <dimen name="continue_radius">26dp</dimen>

    <!-- Native ad (~270dp tall like the reference video). The loading skeleton uses the same
         dimensions and text styles, so the Continue button below it never jumps. -->
    <dimen name="ad_card_radius">16dp</dimen>
    <dimen name="native_icon_size">48dp</dimen>
    <dimen name="native_header_height">52dp</dimen>
    <dimen name="native_media_height">122dp</dimen>
    <dimen name="native_cta_height">46dp</dimen>

    <!-- Banner ad card. The ad sits inside the rounded card with a small frame (never clipped). -->
    <dimen name="banner_card_radius">12dp</dimen>
    <dimen name="banner_frame_padding">4dp</dimen>
    <dimen name="banner_placeholder_height">68dp</dimen>
</resources>
