    <string name="quality_standard">Standard Scan</string>
    <string name="quality_standard_desc">Balanced speed and visual quality.</string>
    <string name="quality_hd">HD Scan</string>
    <string name="quality_hd_desc">Sharper output with better clarity.</string>
    <string name="quality_deep">Deep Scan</string>
    <string name="quality_deep_desc">Maximum simulated detail for richer visuals.</string>
    <string name="quality_smooth">Smooth Mode</string>
    <string name="quality_smooth_desc">Cleaner lines with softer transitions.</string>
    <string name="quality_high_detail">High Detail</string>
    <string name="quality_high_detail_desc">Extra edge and bone definition.</string>
