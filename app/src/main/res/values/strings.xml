    <string name="mode_deep_scan_desc">Advanced scan with maximum details.</string>

    <!-- 3/5 Select Display Style -->
    <string name="style_title">Select Display Style</string>
    <string name="style_subtitle">Choose how your X-ray result should appear.\nEach style changes the look of the final scan preview.</string>
    <string name="style_medical_film">Medical Film</string>
    <string name="style_medical_film_desc">Clean diagnostic-style display with crisp bone tones.</string>
    <string name="style_glow_outline">Glow Outline</string>
    <string name="style_glow_outline_desc">Bright edge glow around bones and body structure.</string>
    <string name="style_night_contrast">Night Contrast</string>
    <string name="style_night_contrast_desc">Dark background with stronger white highlights.</string>
    <string name="style_soft_transparent">Soft Transparent</string>
    <string name="style_soft_transparent_desc">Smooth translucent body effect with softer contrast.</string>
    <string name="style_neon_outline">Neon Outline</string>
    <string name="style_neon_outline_desc">Futuristic neon edge rendering for a vivid look.</string>
    <string name="style_heat_map">Heat Map Style</string>
    <string name="style_heat_map_desc">Warm-to-cool color mapping for a dramatic display.</string>
    <string name="style_bone_highlight">Bone Highlight</string>
